# Delta Exchange API credentials
# Get these from: https://www.delta.exchange/app/account/api-management
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Set to "testnet" for paper trading, "live" for real money
TRADING_MODE=testnet

# Trading parameters
SYMBOL=BTCUSDT          # e.g. BTCUSDT, ETHUSDT
CANDLE_INTERVAL=5m      # 1m, 3m, 5m, 15m, 1h, 4h, 1d
TRADE_SIZE_USD=50       # USD value per trade
MAX_OPEN_TRADES=2       # Maximum simultaneous positions
STOP_LOSS_PCT=2.0       # Stop loss percentage
TAKE_PROFIT_PCT=4.0     # Take profit percentage

# Model parameters
LOOKBACK=60             # Candles to look back for prediction
CONFIDENCE_THRESHOLD=0.65  # Minimum model confidence to trade (0-1)
